/ {
example_sensor: example-sensor {
compatible = "zephyr,example-sensor";
input-gpios = <&porta 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
};

blink_led: blink-led {
compatible = "blink-gpio-led";
led-gpios = <&portb 30 GPIO_ACTIVE_LOW>;
blink-period-ms = <1000>;
};
};

&sercom5 {
status = "okay";
compatible = "atmel,sam0-spi";
#address-cells = <1>;
#size-cells = <0>;

eth_ksz8851: ksz8851@0 {
compatible = "microchip,ksz8851snl", "micrel,ksz8851snl";
reg = <0>;
spi-max-frequency = <12000000>;
int-gpios = <&porta 28 GPIO_ACTIVE_LOW>;
zephyr,random-mac-address;
status = "okay";
};
};

&flash0 {
partitions {
compatible = "fixed-partitions";
#address-cells = <1>;
#size-cells = <1>;

storage_partition: partition@3e000 {
label = "storage";
reg = <0x0003e000 0x00002000>;
};
};
};
